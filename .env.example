# Luna (the agent that decides everything on screen). OPENAI_API_KEY calls OpenAI's own API directly; without it
# OPENROUTER_API_KEY is used (CANVAS_PROVIDER=openrouter forces that even when both are set).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# optional overrides
# CANVAS_MODEL=gpt-5.6-luna
# CANVAS_TRANSPORT=websocket  # OpenAI only; HTTP remains the default and the automatic fallback
# OpenAI requests use Fast mode (`service_tier: fast`) for lower and more consistent demo latency.
# CANVAS_SERVICE_TIER=fast  # use `default` only for a standard-tier comparison
# AGENT_RPM=500
BASETEN_API_KEY=
