# Luna (the agent that decides everything on screen). OPENAI_API_KEY calls OpenAI's own API directly; without it
# OPENROUTER_API_KEY is used (CANVAS_PROVIDER=openrouter forces that even when both are set).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# optional overrides
# CANVAS_MODEL=gpt-5.6-luna
# AGENT_RPM=30
BASETEN_API_KEY=
